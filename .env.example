NODE_ENV=development
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
POSTGRES_USER=fa
POSTGRES_DB=fa_rent_car
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://fa:replace-with-a-random-local-password@127.0.0.1:5432/fa_rent_car?schema=public
REDIS_PASSWORD=replace-with-another-random-password
REDIS_URL=redis://:replace-with-another-random-password@127.0.0.1:6379
MINIO_ROOT_USER=fa-local
MINIO_ROOT_PASSWORD=replace-with-a-random-storage-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fa-private
S3_ACCESS_KEY=fa-local
S3_SECRET_KEY=replace-with-a-random-storage-password
JWT_SECRET=replace-with-at-least-48-random-characters
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SEED_DEMO_DATA=true
